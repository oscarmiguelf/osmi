# Copy to .env (local) or paste into Coolify / Dokploy as environment variables.

# Database (the URL is built from these: avoid @ : / ? # in the password, or the API can't parse it)
POSTGRES_DB=osmi
POSTGRES_USER=osmi
POSTGRES_PASSWORD=change-me-long-random
# The API's own database role (osmi_app: data only, it can't alter tables or disable triggers). Same character rules.
APP_DB_PASSWORD=change-me-other-long-random

# Signs the session tokens: a long random string (e.g. openssl rand -hex 32). Changing it logs everybody out.
JWT_SECRET=change-me-openssl-rand-hex-32

# FIRST START ONLY (empty database volume): login "admin" with this password; the system asks to change it.
ADMIN_PASSWORD=change-me-temporary
BRANCH_NAME=Matriz
BRANCH_CODE=SUC1
REGISTER_NAME=Caja 1

# Proxies in front of the web container (Coolify / Dokploy = 1; with Cloudflare in front too = 2).
# Used to read the visitor's real IP; a wrong value lets visitors fake their IP or blames the proxy.
TRUSTED_PROXY_HOPS=1

# Encrypts the clinical records (health) in the database. Generate once (openssl rand -hex 32), keep it in a safe place
# AND in your backups: if it is lost, the records can't be read; if it leaks, change it is not possible without re-encrypting.
CLINICAL_KEY=change-me-openssl-rand-hex-32
