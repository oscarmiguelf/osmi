DATABASE_URL=postgresql+psycopg://<user>:<password>@host.docker.internal:5432/<db>
JWT_SECRET=<random 64+ chars, e.g. python -c "import secrets; print(secrets.token_urlsafe(64))">
# Who may set X-Forwarded-For (the frontend server). "*" is for local dev only; in production use the frontend's IP.
FORWARDED_ALLOW_IPS=*
