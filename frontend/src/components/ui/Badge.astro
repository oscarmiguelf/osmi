---
// Status label. Color is never the only signal: the text always says the state.
interface Props {
  tone?: 'neutral' | 'success' | 'warning' | 'error' | 'accent';
}

const { tone = 'neutral' } = Astro.props;
---

<span class:list={['badge', tone]}><slot /></span>

<style>
  .badge {
    --tone: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.125rem var(--space-2);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--tone) 14%, var(--bg-app));
    color: var(--text-title);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    white-space: nowrap;
  }

  .badge::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--tone);
  }

  .success { --tone: var(--status-success); }
  .warning { --tone: var(--status-warning); }
  .error { --tone: var(--status-error); }

  /* Accent is the one solid badge: for "new" and counts that need attention */
  .accent {
    background: var(--color-accent);
  }
  .accent::before {
    display: none;
  }
</style>
