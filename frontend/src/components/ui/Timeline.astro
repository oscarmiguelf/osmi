---
// Change history: newest first, each entry with who/when and the fields that changed (before -> after).
import Icon from './Icon.astro';

export interface TimelineItem {
  title: string;
  meta: string;
  changes?: { label: string; from: string; to: string }[];
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<ol class="timeline" role="list">
  {
    items.map((item) => (
      <li>
        <span class="title">{item.title}</span>
        <span class="meta num">{item.meta}</span>
        {item.changes && item.changes.length > 0 && (
          <ul class="changes" role="list">
            {item.changes.map((ch) => (
              <li>
                <span class="field">{ch.label}</span>
                <span class="from">{ch.from}</span>
                <Icon name="arrow-right" size={14} />
                <span class="to">{ch.to}</span>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .timeline > li {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) 0 var(--space-3) var(--space-5);
    border-inline-start: 2px solid var(--border-subtle);
  }

  .timeline > li::before {
    content: '';
    position: absolute;
    top: calc(var(--space-3) + 0.4em);
    inset-inline-start: -6px;
    width: 10px;
    height: 10px;
    background: var(--bg-surface);
    border: 2px solid var(--color-primary);
    border-radius: 50%;
  }

  .title {
    color: var(--text-title);
    font-weight: var(--weight-bold);
  }

  .meta {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .changes {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-1);
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .changes li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .changes :global(svg) {
    color: var(--text-muted);
  }

  .field {
    min-width: 9rem;
    color: var(--text-muted);
  }

  .from {
    color: var(--text-muted);
    text-decoration: line-through;
  }

  .to {
    color: var(--text-title);
    font-weight: var(--weight-medium);
  }

  @media (max-width: 30rem) {
    /* Field name on its own line, "before -> after" together below it */
    .field {
      flex-basis: 100%;
      min-width: 0;
    }

    .changes li {
      row-gap: 0;
      margin-bottom: var(--space-1);
    }
  }
</style>
