---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

type Props = HTMLAttributes<'button'> & Pick<HTMLAttributes<'a'>, 'target' | 'rel'> & {
  variant?: 'primary' | 'secondary' | 'tertiary' | 'danger' | 'destructive';
  /** Renders a link styled as a button. */
  href?: string;
  icon?: string;
};

const { variant = 'primary', href, icon, type = 'button', class: className, ...rest } = Astro.props;
const classes = ['btn', variant, className];
---

{
  href ? (
    <a href={href} class:list={classes} {...(rest as HTMLAttributes<'a'>)}>
      {icon && <Icon name={icon} size={18} />}
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      {icon && <Icon name={icon} size={18} />}
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--control-height);
    padding: 0 var(--space-4);
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .primary {
    background: var(--color-primary);
    color: var(--text-on-color);
  }
  .primary:hover {
    background: var(--color-primary-hover);
  }

  .secondary {
    background: transparent;
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .secondary:hover {
    background: var(--color-primary-tint);
  }

  .tertiary {
    background: transparent;
    color: var(--text-muted);
    padding-inline: var(--space-2);
  }
  .tertiary:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* Low-weight destructive action: delete, remove */
  .danger {
    background: transparent;
    color: var(--status-error-text);
    padding-inline: var(--space-2);
  }
  .danger:hover {
    background: color-mix(in srgb, var(--status-error) 8%, transparent);
  }

  /* Confirms a destructive action in a confirmation dialog */
  .destructive {
    background: var(--status-error);
    color: var(--text-on-color);
  }
  .destructive:hover {
    background: color-mix(in srgb, var(--status-error) 85%, var(--text-title));
  }

  .btn:disabled,
  .btn[aria-disabled='true'] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }
</style>
