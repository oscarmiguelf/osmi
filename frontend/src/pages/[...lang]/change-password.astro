---
// Forced after signing in with a temporary password. Changing it ends every session, so we sign in again right away.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Field from '@/components/ui/Field.astro';
import { getLocale, localePath, useTranslations } from '@/i18n';
import { ApiError, login } from '@/lib/api';
import { startSession } from '@/lib/session';
import { changeMyPassword } from '@/lib/users';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const cp = t.changePassword;
const { session, accessToken } = Astro.locals as Required<App.Locals>;
const errors: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const [current, next, confirm] = ['current', 'next', 'confirm'].map((k) => String(data.get(k) ?? ''));
  if (next !== confirm) errors.confirm = cp.mismatch;
  else {
    try {
      await changeMyPassword(accessToken, current, next);
      const result = await login(session.user.email, next, { ip: Astro.locals.clientIp, userAgent: Astro.request.headers.get('user-agent') });
      if (result.tokens) startSession(Astro.cookies, result.tokens);
      return Astro.redirect(localePath(locale, result.tokens ? '/' : '/login'), 303);
    } catch (e) {
      if (!(e instanceof ApiError)) throw e;
      const detail = e.body?.detail;
      if (detail?.field === 'current_password') errors.current = cp.wrongCurrent;
      else if (Array.isArray(detail?.rules)) errors.next = detail.rules.map((r: string) => cp.rules[r] ?? r).join(' ');
      else errors.next = t.ui.failed;
    }
  }
  Astro.response.status = 422;
}
---

<BaseLayout title={cp.title}>
  <main class="page">
    <section class="panel" aria-labelledby="cp-title">
      <h1 id="cp-title">{cp.title}</h1>
      <p class="intro">{cp.intro}</p>
      <form method="post" class="form" novalidate>
        <Field label={cp.current} name="current" type="password" autocomplete="current-password" error={errors.current} required autofocus />
        <Field label={cp.next} name="next" type="password" autocomplete="new-password" hint={errors.next ? undefined : cp.hint} error={errors.next} required />
        <Field label={cp.confirm} name="confirm" type="password" autocomplete="new-password" error={errors.confirm} required />
        <Button type="submit">{cp.submit}</Button>
      </form>
      <form method="post" action="/logout" class="logout">
        <input type="hidden" name="locale" value={locale} />
        <Button type="submit" variant="tertiary" icon="log-out">{t.app.logout}</Button>
      </form>
    </section>
  </main>
</BaseLayout>

<style>
  .page {
    display: grid;
    place-items: center;
    min-height: 100dvh;
    padding: var(--space-8) var(--space-4);
    background: var(--bg-surface);
  }
  .panel {
    width: min(100%, 26rem);
    padding: var(--space-8) var(--space-6) var(--space-5);
    background: var(--bg-app);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-container);
    box-shadow: var(--shadow-overlay);
  }
  h1 {
    font-size: var(--text-xl);
  }
  .intro {
    margin-top: var(--space-2);
    color: var(--text-muted);
  }
  .form {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .logout {
    margin-top: var(--space-4);
  }
</style>
