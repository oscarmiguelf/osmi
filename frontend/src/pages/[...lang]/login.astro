---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Field from '@/components/ui/Field.astro';
import Icon from '@/components/ui/Icon.astro';
import { alternatePath, getLocale, localePath, useTranslations } from '@/i18n';
import { login } from '@/lib/api';
import { startSession } from '@/lib/session';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const l = t.login;

let error: string | undefined;
let email = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');

  if (!email || !password) {
    error = l.missing;
  } else {
    try {
      const result = await login(email, password, {
        ip: Astro.locals.clientIp,
        userAgent: Astro.request.headers.get('user-agent'),
      });
      if (result.tokens) {
        startSession(Astro.cookies, result.tokens);
        return Astro.redirect(localePath(locale, '/'), 303);
      }
      error = result.status === 429 ? l.tooMany : result.status >= 500 ? l.unavailable : l.invalid;
    } catch {
      error = l.unavailable;
    }
    Astro.response.status = 401;
  }
}
---

<BaseLayout title={l.title}>
  <main class="login">
    <p class="brand">
      <span class="mark" aria-hidden="true"></span>
      {t.app.name}
    </p>

    <section class="panel" aria-labelledby="login-title">
      <h1 id="login-title">{l.title}</h1>
      <p class="intro">{l.intro}</p>

      {
        error && (
          <p class="alert" role="alert">
            <Icon name="circle-alert" size={18} />
            {error}
          </p>
        )
      }

      <form method="post" class="form">
        <Field
          label={l.email}
          name="email"
          value={email}
          required
          autocomplete="username"
          autocapitalize="none"
          spellcheck="false"
          autofocus={!email}
        />
        <Field
          label={l.password}
          name="password"
          type="password"
          required
          autocomplete="current-password"
          autofocus={!!email}
        />
        <Button type="submit" class="submit">{l.submit}</Button>
      </form>
    </section>

    <a class="language" href={alternatePath(locale, Astro.url.pathname)} lang={locale === 'es' ? 'en' : 'es'}>
      <Icon name="languages" size={18} />
      {t.app.switchLanguage}
    </a>
  </main>
  <script>
    // Signed out: the device forgets the catalog and customers it kept for selling offline (unsent sales stay: they were paid)
    import { forgetSnapshot } from '@/lib/offline/store';
    if ('indexedDB' in window) forgetSnapshot().catch(() => {});
  </script>
</BaseLayout>

<style>
  .login {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-6);
    min-height: 100dvh;
    padding: var(--space-8) var(--space-4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-title);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    text-decoration: none;
  }

  .mark {
    width: 1.5rem;
    height: 1.5rem;
    border: 4px solid var(--color-primary);
    border-radius: 5px;
  }

  .panel {
    width: min(100%, 24rem);
    padding: var(--space-8) var(--space-6);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-container);
  }

  .intro {
    margin-top: var(--space-2);
    color: var(--text-muted);
  }

  .alert {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-5);
    padding: var(--space-3);
    background: color-mix(in srgb, var(--status-error) 8%, var(--bg-app));
    border: 1px solid var(--status-error);
    border-radius: var(--radius-control);
    color: var(--text-title);
    font-size: var(--text-sm);
  }

  .alert :global(svg) {
    flex-shrink: 0;
    margin-top: 0.1em;
    color: var(--status-error-text);
  }

  .form {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .form > :global(.submit) {
    width: 100%;
    margin-top: var(--space-1);
  }

  .language {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .language:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>
